{
  "info": {
    "_postman_id": "c4f1f4a4-7a56-4e6d-8c10-oficina-api",
    "name": "Oficina API",
    "description": "Collection completa da API Oficina, com fluxo principal automatizado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if ((pm.environment.get('adminEmail') || '').includes('{{$timestamp}}')) {",
          "  const suffix = Date.now();",
          "  pm.environment.set('adminEmail', `admin${suffix}@oficina.local`);",
          "  pm.environment.set('clienteEmail', `cliente${suffix}@oficina.local`);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Fluxo principal",
      "item": [
        {
          "name": "1. Cadastrar Admin",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Administrador Oficina\",\n  \"email\": \"{{adminEmail}}\",\n  \"senha\": \"{{adminSenha}}\",\n  \"role\": 1\n}" }, "url": { "raw": "{{baseUrl}}/api/auth/usuarios", "host": ["{{baseUrl}}"], "path": ["api", "auth", "usuarios"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Usuário Admin criado', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));", "if (pm.response.code < 300) pm.environment.set('adminId', pm.response.json());"] } }]
        },
        {
          "name": "2. Login Admin",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"senha\": \"{{adminSenha}}\"\n}" }, "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Login Admin realizado', () => pm.response.to.have.status(200));", "pm.environment.set('adminToken', pm.response.json().token);"] } }]
        },
        {
          "name": "3. Cadastrar Cliente",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Cliente Teste Oficina\",\n  \"email\": \"{{clienteEmail}}\",\n  \"senha\": \"{{clienteSenha}}\",\n  \"role\": 3,\n  \"documento\": \"{{clienteDocumento}}\"\n}" }, "url": { "raw": "{{baseUrl}}/api/auth/usuarios", "host": ["{{baseUrl}}"], "path": ["api", "auth", "usuarios"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Usuário Cliente criado', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));", "if (pm.response.code < 300) pm.environment.set('clienteUsuarioId', pm.response.json());"] } }]
        },
        {
          "name": "4. Login Cliente",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{clienteEmail}}\",\n  \"senha\": \"{{clienteSenha}}\"\n}" }, "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Login Cliente realizado', () => pm.response.to.have.status(200));", "pm.environment.set('clienteToken', pm.response.json().token);"] } }]
        },
        {
          "name": "5. Localizar Cliente",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": { "raw": "{{baseUrl}}/api/clientes?term=Cliente%20Teste%20Oficina&offset=0&limit=20", "host": ["{{baseUrl}}"], "path": ["api", "clientes"], "query": [{ "key": "term", "value": "Cliente Teste Oficina" }, { "key": "offset", "value": "0" }, { "key": "limit", "value": "20" }] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Cliente localizado', () => pm.response.to.have.status(200));", "const data = pm.response.json();", "const cliente = (data.itens || []).find(x => x.nome === 'Cliente Teste Oficina');", "pm.expect(cliente, 'cliente criado').to.exist;", "pm.environment.set('clienteId', cliente.id);"] } }]
        },
        {
          "name": "6. Criar Item de Catálogo",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Troca de óleo - teste\",\n  \"preco\": 150.00,\n  \"tipo\": 1,\n  \"quantidadeEstoque\": 20\n}" }, "url": { "raw": "{{baseUrl}}/api/itens-catalogo", "host": ["{{baseUrl}}"], "path": ["api", "itens-catalogo"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Item criado', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));", "pm.environment.set('itemCatalogoId', pm.response.json());"] } }]
        },
        {
          "name": "7. Criar Veículo",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"clienteId\": \"{{clienteId}}\",\n  \"placa\": \"ABC1D23\",\n  \"marca\": \"Toyota\",\n  \"modelo\": \"Corolla\",\n  \"ano\": 2023\n}" }, "url": { "raw": "{{baseUrl}}/api/veiculos", "host": ["{{baseUrl}}"], "path": ["api", "veiculos"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Veículo criado', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));", "pm.environment.set('veiculoId', pm.response.json());"] } }]
        },
        {
          "name": "8. Criar OS com orçamento",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"clienteId\": \"{{clienteId}}\",\n  \"veiculoId\": \"{{veiculoId}}\",\n  \"descricao\": \"Revisão preventiva - fluxo Postman\",\n  \"valorMaoDeObra\": 100.00,\n  \"itens\": [\n    {\n      \"itemCatalogoId\": \"{{itemCatalogoId}}\",\n      \"quantidade\": 1\n    }\n  ]\n}" }, "url": { "raw": "{{baseUrl}}/api/ordens-servico", "host": ["{{baseUrl}}"], "path": ["api", "ordens-servico"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('OS criada', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));", "pm.environment.set('ordemServicoId', pm.response.json());"] } }]
        },
        {
          "name": "9. Consultar orçamento",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": { "raw": "{{baseUrl}}/api/ordens-servico/{{ordemServicoId}}/orcamento", "host": ["{{baseUrl}}"], "path": ["api", "ordens-servico", "{{ordemServicoId}}", "orcamento"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Orçamento consultado', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "10. Status: Em diagnóstico",
          "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"status\": 2, \"observacao\": \"Diagnóstico iniciado\" }" }, "url": { "raw": "{{baseUrl}}/api/ordens-servico/{{ordemServicoId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "ordens-servico", "{{ordemServicoId}}", "status"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status alterado para EmDiagnostico', () => pm.response.to.have.status(204));"] } }]
        },
        {
          "name": "11. Status: Aguardando aprovação",
          "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"status\": 3, \"observacao\": \"Orçamento enviado ao cliente\" }" }, "url": { "raw": "{{baseUrl}}/api/ordens-servico/{{ordemServicoId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "ordens-servico", "{{ordemServicoId}}", "status"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status alterado para AguardandoAprovacao', () => pm.response.to.have.status(204));"] } }]
        },
        {
          "name": "12. Cliente aprova orçamento",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{clienteToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"decisao\": 2 }" }, "url": { "raw": "{{baseUrl}}/api/ordens-servico/{{ordemServicoId}}/orcamento/decisao", "host": ["{{baseUrl}}"], "path": ["api", "ordens-servico", "{{ordemServicoId}}", "orcamento", "decisao"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Orçamento aprovado', () => pm.response.to.have.status(204));"] } }]
        },
        {
          "name": "13. Cliente consulta minhas OS",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{clienteToken}}" }], "url": { "raw": "{{baseUrl}}/api/ordens-servico/minhas?offset=0&limit=20", "host": ["{{baseUrl}}"], "path": ["api", "ordens-servico", "minhas"], "query": [{ "key": "offset", "value": "0" }, { "key": "limit", "value": "20" }] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('OS do cliente consultadas', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "14. Status: Finalizada",
          "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"status\": 5, \"observacao\": \"Serviço finalizado\" }" }, "url": { "raw": "{{baseUrl}}/api/ordens-servico/{{ordemServicoId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "ordens-servico", "{{ordemServicoId}}", "status"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status alterado para Finalizada', () => pm.response.to.have.status(204));"] } }]
        },
        {
          "name": "15. Status: Entregue",
          "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"status\": 6, \"observacao\": \"Veículo entregue ao cliente\" }" }, "url": { "raw": "{{baseUrl}}/api/ordens-servico/{{ordemServicoId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "ordens-servico", "{{ordemServicoId}}", "status"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status alterado para Entregue', () => pm.response.to.have.status(204));"] } }]
        }
      ]
    },
    {
      "name": "02 - Consultas",
      "item": [
        { "name": "Listar clientes", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/clientes?offset=0&limit=20" } },
        { "name": "Obter cliente", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/clientes/{{clienteId}}" } },
        { "name": "Listar itens de catálogo", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/itens-catalogo?offset=0&limit=20" } },
        { "name": "Obter item de catálogo", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/itens-catalogo/{{itemCatalogoId}}" } },
        { "name": "Listar veículos", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/veiculos?offset=0&limit=20" } },
        { "name": "Obter veículo", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/veiculos/{{veiculoId}}" } },
        { "name": "Listar ordens de serviço", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/ordens-servico?offset=0&limit=20" } },
        { "name": "Obter ordem de serviço", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/ordens-servico/{{ordemServicoId}}" } },
        { "name": "Ordens por nome do cliente", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/ordens-servico/por-cliente?nome=Cliente%20Teste%20Oficina&offset=0&limit=20" } },
        { "name": "Histórico da ordem", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/ordens-servico/{{ordemServicoId}}/historico" } }
      ]
    },
    {
      "name": "03 - CRUD",
      "item": [
        { "name": "Atualizar cliente", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"nome\": \"Cliente Teste Oficina Atualizado\", \"documento\": \"52998224725\" }" }, "url": "{{baseUrl}}/api/clientes/{{clienteId}}" } },
        { "name": "Excluir cliente", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/clientes/{{clienteId}}" } },
        { "name": "Atualizar item de catálogo", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"nome\": \"Troca de óleo atualizada\", \"preco\": 170.00, \"tipo\": 1, \"quantidadeEstoque\": 20 }" }, "url": "{{baseUrl}}/api/itens-catalogo/{{itemCatalogoId}}" } },
        { "name": "Adicionar itens ao estoque", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"quantidade\": 10 }" }, "url": "{{baseUrl}}/api/itens-catalogo/{{itemCatalogoId}}/estoque" } },
        { "name": "Excluir item de catálogo", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/itens-catalogo/{{itemCatalogoId}}" } },
        { "name": "Atualizar veículo", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"clienteId\": \"{{clienteId}}\", \"placa\": \"ABC1D23\", \"marca\": \"Toyota\", \"modelo\": \"Corolla XEi\", \"ano\": 2023 }" }, "url": "{{baseUrl}}/api/veiculos/{{veiculoId}}" } },
        { "name": "Excluir veículo", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/veiculos/{{veiculoId}}" } },
        { "name": "Atualizar ordem de serviço", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"clienteId\": \"{{clienteId}}\", \"veiculoId\": \"{{veiculoId}}\", \"status\": 6, \"valorTotal\": 250.00 }" }, "url": "{{baseUrl}}/api/ordens-servico/{{ordemServicoId}}" } },
        { "name": "Excluir ordem de serviço", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/ordens-servico/{{ordemServicoId}}" } }
      ]
    }
  ]
}
